# Backend runtime (built binary at repo root). Root-anchored so that cmd/home
# and internal/... are never ignored.
/home
data/
web/node_modules/

# Vite build output, except the placeholder that keeps go:embed compiling
web/dist/*
!web/dist/.gitkeep

# Prebuilt deployment binaries (regenerate with `make caddy-dist`)
deploy/dist/
deploy/caddy-build/caddy-build

# Editor / OS
.DS_Store
.idea/
*.db
*.db-wal
*.db-shm
